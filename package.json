{
  "name": "storage",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "run-p \"dev:api\" \"dev:s3\" --",
    "dev:api": "nest start --watch api",
    "dev:s3": "nest start --watch s3",
    "env:init": "cp .env.sample .env",
    "db": "bash ./scripts/db-tool",
    "build": "nest build",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "dev:web-storage": "cd web && vite --config vite.config.storage.mts",
    "dev:web": "run-p \"dev:web-storage\"",
    "build:web-storage": "cd web && tsc -b && vite build --config vite.config.storage.mts",
    "build:web": "tsc -b web && npm run build:web-storage",
    "lint:web": "eslint -c web/eslint.config.mjs \"web/**/*.{ts,tsx}\" --fix",
    "orval:web-storage": "del ./web/apps/storage/src/api/schema/* && orval --config ./web/orval.config.js --project storageApi"
  },
  "engines": {
    "npm": ">=11.6",
    "node": ">=24.10"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.7",
    "@nestjs/core": "^11.1.7",
    "@nestjs/platform-express": "^11.1.7",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "axios": "^1.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "drizzle-orm": "^0.44.2",
    "fast-xml-parser": "^5.2.5",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router": "^7.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@apinecka/eslint-config-be": "^1.0.0",
    "@apinecka/eslint-config-web": "^1.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.29.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.7",
    "@swc/cli": "^0.7.7",
    "@swc/core": "^1.12.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.33",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitejs/plugin-react": "^4.3.4",
    "copy-webpack-plugin": "^13.0.1",
    "del-cli": "^7.0.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "generate-package-json-webpack-plugin": "^2.6.0",
    "globals": "^16.2.0",
    "jest": "^30.0.2",
    "npm-run-all": "^4.1.5",
    "orval": "^7.21.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.1",
    "terser-webpack-plugin": "^5.4.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
