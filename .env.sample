# Management API (REST for the UI)
API_PORT=10410
# Largest JSON/form body accepted; object payloads bypass the parsers entirely
API_MAX_BODY_BYTES=1mb
# Ceiling on one upload through the management API, in bytes (5 GiB)
API_MAX_UPLOAD_BYTES=5368709120

# S3-compatible API
S3_PORT=10411
# Region reported in S3 responses / expected in SigV4 credential scope
S3_REGION=us-east-1
# Base domain for virtual-host style addressing (<bucket>.<S3_ENDPOINT_DOMAIN>); empty = path style only
S3_ENDPOINT_DOMAIN=
# Origin the S3 endpoint is reachable at from outside - the base of presigned share links
S3_PUBLIC_URL=http://localhost:10411
# Largest single PUT; a bigger object has to use multipart upload, as in S3 (5 GiB)
S3_MAX_SINGLE_UPLOAD_BYTES=5368709120

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=10400
POSTGRES_DB=core
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL=4
# Where the migration SQL lives; only needed when the default relative path does not apply
# (a container or a systemd install), see docker/Dockerfile
#MIGRATIONS_CORE_PATH=/app/migrations

# Valkey - spoken to with the redis client, the protocol is the same
VALKEY_HOST=localhost
VALKEY_PORT=10401
#VALKEY_PASSWORD=

# Request rate limiting (shared across instances through Valkey).
# An unreachable Valkey lets every request through rather than blocking it.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=600

# Object data on disk
STORAGE_DATA_PATH=./data/objects

# Server-side encryption at rest (SSE-S3). Each object gets its own key, wrapped with the one
# below - losing it makes every object written under it unreadable, so back it up and do not
# rotate it without re-wrapping. Defaults to CRYPTOGRAPHIC_PASSWORD when unset.
STORAGE_ENCRYPTION=true
STORAGE_ENCRYPTION_KEY="dev-encryption-key-32-chars-min!"

# Blob garbage collection - runs in apps/api only.
# Reclaims blobs no version row points at and aborts multipart uploads nobody finished.
GC_ENABLED=true
GC_CRON="17 3 * * *"
GC_MULTIPART_MAX_AGE_HOURS=168
# How old a blob must be before it counts as orphaned: a payload is written before its row is
# committed, so anything younger may be an upload still in flight.
GC_BLOB_MIN_AGE_HOURS=24

# Auth (management users)
JWT_SECRET="dev-secret-change-me"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Secret-key encryption at rest
CRYPTOGRAPHIC_PASSWORD="dev-secret-password-32-chars-min"

# Created on first boot when the deployment has no users yet - change the password after login
BOOTSTRAP_ADMIN_EMAIL=admin@storage.local
BOOTSTRAP_ADMIN_PASSWORD=admin12345

# CORS for the UI
CORS=http://localhost:10412
