#!/bin/sh
# Writes the two files that are the same in every image and different in every deployment: the
# UI's runtime config and the nginx server block.
#
# Neither can be baked in at build time. The bundle is static, so the address the browser should
# call the management API at is not known until the container starts; and the port the UI is
# served on is a variable like any other.
set -eu

# A relative apiUrl is the default because it is the only one that cannot be wrong: the UI calls
# back to whatever origin it was loaded from, and nginx below proxies /api/ to the management API
# in this same container. An absolute API_PUBLIC_URL is for deployments that expose the two
# separately - and then CORS on the API has to name that origin.
cat > /usr/share/nginx/html/config.json <<JSON
{
	"apiUrl": "${API_PUBLIC_URL}"
}
JSON

cat > /etc/nginx/nginx.conf <<CONF
# Generated by storage-init-web on container start - edits here do not survive a restart.
user nginx;
worker_processes ${WEB_WORKER_PROCESSES};
pid /run/nginx.pid;
error_log /dev/stderr ${WEB_ERROR_LOG_LEVEL};

events {
	worker_connections ${WEB_WORKER_CONNECTIONS};
}

http {
	include /etc/nginx/mime.types;
	default_type application/octet-stream;
	sendfile on;
	server_tokens off;
	access_log ${WEB_ACCESS_LOG};

	# The applications log one JSON line per finished request themselves, including the real
	# duration - nginx would only add a second, less informed copy.
	log_format storage '\$remote_addr "\$request" \$status \$body_bytes_sent \$request_time';

	# Uploads are bounded by API_MAX_UPLOAD_BYTES inside the application, which enforces it while
	# streaming. A limit here would only turn an over-large upload into an HTML error page the UI
	# cannot render as a code.
	client_max_body_size 0;

	server {
		listen ${WEB_PORT};
		listen [::]:${WEB_PORT};
		server_name _;
		root /usr/share/nginx/html;

		# Single-page app: anything that is not a file on disk is answered with the shell, or a
		# reload of /buckets/name is a 404.
		location / {
			try_files \$uri \$uri/ /index.html;
		}

		# Hashed assets are immutable. The shell and the runtime config never are, or a restart
		# with a new API_PUBLIC_URL would keep serving the old one out of the browser cache.
		location /assets/ {
			expires 1y;
			add_header Cache-Control "public, immutable";
		}

		location = /index.html {
			add_header Cache-Control "no-cache";
		}

		location = /config.json {
			add_header Cache-Control "no-cache";
		}

		# The management API, on the UI's own origin so the browser needs no CORS preflight.
		# Buffering is off in both directions: an object upload is streamed to disk as it
		# arrives and a download is streamed back, and nginx spooling either one to a temporary
		# file would double the disk traffic and break the progress bar.
		location /api/ {
			proxy_pass http://127.0.0.1:${API_PORT}/;
			proxy_http_version 1.1;
			proxy_set_header Host \$host;
			proxy_set_header X-Real-IP \$remote_addr;
			proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto \$scheme;
			proxy_request_buffering off;
			proxy_buffering off;
			proxy_read_timeout ${WEB_PROXY_TIMEOUT};
			proxy_send_timeout ${WEB_PROXY_TIMEOUT};
		}

		gzip on;
		gzip_types text/css application/javascript application/json image/svg+xml;
	}
}
CONF

nginx -t -c /etc/nginx/nginx.conf
echo "web: UI on port ${WEB_PORT}, management API at ${API_PUBLIC_URL}"
