# Configuration for the standalone image (docker-compose.standalone.yml).
#
#   cp .env.standalone.sample .env.standalone
#
# Everything below is optional except the five values in the first block. The container checks
# those at start and refuses to boot without them, because each one has a working default in the
# code and every one of those defaults is either public knowledge or plainly wrong.

# ---------------------------------------------------------------- required

# Generate each of these once with `openssl rand -base64 36` and keep them. In particular:
# rotating STORAGE_ENCRYPTION_KEY without re-wrapping the existing data keys makes every object
# written under the old one unreadable - it is the one value no backup of anything else recovers.
JWT_SECRET=
CRYPTOGRAPHIC_PASSWORD=
STORAGE_ENCRYPTION_KEY=

# The admin account created on first boot, together with BOOTSTRAP_ADMIN_EMAIL below.
BOOTSTRAP_ADMIN_PASSWORD=

# The origin S3 clients reach this container at - the base of every presigned share link. It has
# to be the address a browser outside the container would use, not the container's own.
S3_PUBLIC_URL=https://s3.example.com

# ---------------------------------------------------------------- ports and addresses

# The ports the services listen on *inside* the container. With docker-compose.standalone.yml
# leave them alone and change the published side there instead: compose interpolates its `ports`
# from the shell or `.env`, not from this file, so moving a listener here only makes the two
# disagree. They matter for a plain `docker run` and for orchestrators that map nothing.
#
# Management UI, and the management API proxied under /api on the same origin.
#WEB_PORT=4242
# The S3 endpoint. 443 is where AWS serves S3, which is why it is the default.
#S3_PORT=443
# The management API's own port. Publish it only if something other than the UI calls it
# directly - and then set CORS.
#API_PORT=10410

# Where the browser should call the management API. A relative value keeps it on the UI's origin
# and needs no CORS; an absolute one (https://api.example.com) needs CORS set to the UI's origin.
API_PUBLIC_URL=/api
#CORS=https://storage.example.com

# Region reported in S3 responses and expected in the SigV4 credential scope.
S3_REGION=us-east-1
# Base domain for virtual-host style addressing (<bucket>.<domain>); empty means path style only.
S3_ENDPOINT_DOMAIN=

BOOTSTRAP_ADMIN_EMAIL=admin@storage.local

# ---------------------------------------------------------------- limits

# Largest single PUT on the S3 endpoint; anything bigger has to use multipart upload, as in S3.
S3_MAX_SINGLE_UPLOAD_BYTES=5368709120
# Ceiling on one upload through the management API, enforced while streaming.
API_MAX_UPLOAD_BYTES=5368709120
# Largest JSON/form body; object payloads bypass the parsers entirely.
API_MAX_BODY_BYTES=1mb
# Lifetime a presigned link gets when the caller does not ask for one.
API_PRESIGN_DEFAULT_SECONDS=3600

# Session lifetimes for the management UI, in seconds.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=storage

# Requests one caller may make per window. An unreachable counter store lets requests through.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=600

# ---------------------------------------------------------------- storage and encryption

# Everything persistent, under one root. Mount a volume here.
STORAGE_ROOT=/data
STORAGE_DATA_PATH=/data/objects

# Server-side encryption at rest (SSE-S3). Recorded per object version, so turning it off later
# leaves what is already written readable.
STORAGE_ENCRYPTION=true

# Reclaims blobs no version row points at and aborts multipart uploads nobody finished.
GC_ENABLED=true
GC_CRON=17 3 * * *
GC_MULTIPART_MAX_AGE_HOURS=168
# How old a blob must be before it counts as orphaned: a payload is written before its row is
# committed, so anything younger may be an upload still in flight.
GC_BLOB_MIN_AGE_HOURS=24

# Timezone the GC cron expression is read in.
TZ=UTC

# ---------------------------------------------------------------- embedded Postgres

# The database is not published and binds to the container's loopback address only. Leave
# POSTGRES_PASSWORD empty and one is generated on first boot and kept in $STORAGE_ROOT.
POSTGRES_DB=core
POSTGRES_USER=postgres
#POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Connections each application keeps open; both share POSTGRES_MAX_CONNECTIONS.
POSTGRES_POOL=8
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100
# Anything else the server should be started with, e.g. "-c work_mem=16MB -c wal_level=minimal".
POSTGRES_EXTRA_ARGS=

# ---------------------------------------------------------------- embedded Valkey

# Holds the rate-limit counters and nothing else, so it is run as a cache: no snapshots, and a
# ceiling it evicts under rather than grows into the host.
VALKEY_PORT=6379
#VALKEY_PASSWORD=
VALKEY_APPENDONLY=no
VALKEY_MAXMEMORY=128mb
VALKEY_MAXMEMORY_POLICY=allkeys-lru

# ---------------------------------------------------------------- web server

WEB_WORKER_PROCESSES=auto
WEB_WORKER_CONNECTIONS=1024
# "off", or "/dev/stdout storage" to log one line per request served by nginx. The applications
# log their own requests as JSON either way.
WEB_ACCESS_LOG=off
WEB_ERROR_LOG_LEVEL=warn
# How long nginx waits on the management API - an upload of several gigabytes is one request.
WEB_PROXY_TIMEOUT=1h
